# Dockerfile for building static Android-bionic test binaries for pwndbg, one per
# Android API level. Mirrors Dockerfile.musl-test-libs / Dockerfile.glibc-test-libs.
#
# CI (heap-libc-tests.yml) builds this per-arch and publishes the per-arch tag plus
# a :latest manifest. To build it locally for testing:
#   docker buildx build -f Dockerfile.bionic-test-libs -t bionic-test-libs:local .
#
# KEY DIFFERENCE from the glibc/musl images: those ship libc artifacts and the
# pwndbg test container compiles the test binaries (via the makefile + zig cc).
# Bionic test binaries must be built with the NDK clang, which is NOT in the
# pwndbg test container, so we pre-build the binaries here and ship them. The
# test then uses the extracted pre-built binaries directly (no makefile rule).
#
# The final image is a minimal scratch image containing only the binaries:
#   /bionics/21/bionic_probe.bionic-21-static.out  /bionics/26/...  ...

# debian:12 (bookworm), pinned by digest for reproducibility.
FROM debian:12@sha256:ed4fcc40bb1162b6d2d32e7bec15044d13963779abbe63f67f1cd62b06220519 AS base-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    unzip \
    binutils \
    file \
    && rm -rf /var/lib/apt/lists/*

# Download the Android NDK once in the shared base stage so every per-API build
# stage reuses the same cached layer (the NDK is large; downloading per-stage
# would be wasteful). Pinned to r27d (the current LTS NDK); the sha1 below verifies it.
ARG NDK_VERSION=r27d
# SHA1 Google publishes for this NDK_VERSION's Linux zip; bump both together.
ARG NDK_SHA1=22105e410cf29afcf163760cc95522b9fb981121
RUN curl -fsSL -o /tmp/ndk.zip \
        "https://dl.google.com/android/repository/android-ndk-${NDK_VERSION}-linux.zip" \
    && echo "${NDK_SHA1}  /tmp/ndk.zip" | sha1sum -c - \
    && unzip -q /tmp/ndk.zip -d /opt \
    && rm /tmp/ndk.zip
ENV NDK_HOME=/opt/android-ndk-${NDK_VERSION}

COPY scripts/build-one-bionic.sh /build-one-bionic.sh
RUN chmod +x /build-one-bionic.sh
COPY tests/binaries/host/bionic_probe.native.c /bionic_probe.native.c

# Build each API level in a separate stage for caching.
# The download script (sed) and the test (Python re) both parse the API list from
# these build-<API> stages, so add/remove an API level here only. API levels are
# plain integers.
# Each RUN produces /bionics/<API>/ with the static probe binary.

FROM base-builder AS build-21
RUN /build-one-bionic.sh 21

FROM base-builder AS build-26
RUN /build-one-bionic.sh 26

FROM base-builder AS build-30
RUN /build-one-bionic.sh 30

FROM base-builder AS build-34
RUN /build-one-bionic.sh 34

# Final minimal image with just the binaries
FROM scratch
COPY --from=build-21 /bionics/21 /bionics/21
COPY --from=build-26 /bionics/26 /bionics/26
COPY --from=build-30 /bionics/30 /bionics/30
COPY --from=build-34 /bionics/34 /bionics/34
