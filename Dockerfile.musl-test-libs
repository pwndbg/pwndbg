# Dockerfile for building musl libc shared libraries for testing pwndbg against
# multiple musl versions. Mirrors Dockerfile.glibc-test-libs.
#
# CI (heap-libc-tests.yml) builds this per-arch and publishes the per-arch tags plus
# a :latest multi-arch manifest. To build it locally for testing:
#   docker buildx build -f Dockerfile.musl-test-libs -t musl-test-libs:local .
#
# The final image is a minimal scratch image containing only the musl artifacts:
#   /musls/1.2.5/lib/{libc.a,libc.so,ld-musl-<arch>.so.1,crt*.o}  /musls/1.2.5/include/  ...

# debian:12 (bookworm), pinned by digest for reproducibility.
FROM debian:12@sha256:ed4fcc40bb1162b6d2d32e7bec15044d13963779abbe63f67f1cd62b06220519 AS base-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    wget \
    ca-certificates \
    patchelf \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/build-one-musl.sh /build-one-musl.sh
RUN chmod +x /build-one-musl.sh

# Build each musl version in a separate stage for caching.
# The makefile, download script, and test parse the version list from these
# build-<ver> stages, so add/remove a version by editing this file (the stage and
# its COPY below) plus its sha256 pin in scripts/build-one-musl.sh.
# Each RUN produces /musls/<version>/ with the artifacts.

FROM base-builder AS build-1.1.24
RUN /build-one-musl.sh 1.1.24

FROM base-builder AS build-1.2.1
RUN /build-one-musl.sh 1.2.1

FROM base-builder AS build-1.2.2
RUN /build-one-musl.sh 1.2.2

FROM base-builder AS build-1.2.3
RUN /build-one-musl.sh 1.2.3

FROM base-builder AS build-1.2.4
RUN /build-one-musl.sh 1.2.4

FROM base-builder AS build-1.2.5
RUN /build-one-musl.sh 1.2.5

FROM base-builder AS build-1.2.6
RUN /build-one-musl.sh 1.2.6

# Final minimal image with just the artifacts
FROM scratch
COPY --from=build-1.1.24 /musls/1.1.24 /musls/1.1.24
COPY --from=build-1.2.1 /musls/1.2.1 /musls/1.2.1
COPY --from=build-1.2.2 /musls/1.2.2 /musls/1.2.2
COPY --from=build-1.2.3 /musls/1.2.3 /musls/1.2.3
COPY --from=build-1.2.4 /musls/1.2.4 /musls/1.2.4
COPY --from=build-1.2.5 /musls/1.2.5 /musls/1.2.5
COPY --from=build-1.2.6 /musls/1.2.6 /musls/1.2.6
