# Dockerfile.hybrid - Complete pwndbg testing environment
# Supports both GDB (236/236 tests passing) and LLDB testing infrastructure
#
# Build: docker build -f Dockerfile.hybrid -t pwndbg-hybrid:latest .
# Run:   docker run -it --cap-add=SYS_PTRACE --security-opt seccomp=unconfined pwndbg-hybrid:latest
# Test:  ./tests.sh -g gdb -d gdb    # Perfect GDB testing (236/236 tests)
#        ./tests.sh -g lldb -d lldb  # LLDB testing infrastructure ready

FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive

# Pull the pre-built LLDB toolchain in one line 🎉
COPY --from=ghcr.io/nouser/lldb19-ubuntu24:latest /opt/llvm-19 /opt/llvm-19
RUN ln -s /opt/llvm-19/bin/lldb /usr/local/bin/lldb

# Regular deps (fast) + CRITICAL: python3.10 for LLDB compatibility + i386 support for 32-bit test fixes
RUN apt-get update && apt-get install -y --no-install-recommends \
        gdb gdb-multiarch python3.10 python3.10-minimal libpython3.10 \
        python3.10-pip python3.10-venv python3-lldb-19 \
        build-essential git curl ca-certificates \
        qemu-system-x86 qemu-user vim-common \
        nasm gcc patchelf golang && \
    dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        libc6:i386 libc6-dbg:i386 libc6-dev:i386 \
        libgcc-s1:i386 libstdc++6:i386 lib32z1 \
        gcc-multilib g++-multilib && \
    rm -rf /var/lib/apt/lists/*

# Install Zig for test binary compilation
RUN curl -L https://ziglang.org/download/0.13.0/zig-linux-x86_64-0.13.0.tar.xz -o /tmp/zig.tar.xz && \
    echo "d45312e61ebcc48032b77bc4cf7fd6915c11fa16e4aad116b66c9468211230ea /tmp/zig.tar.xz" | sha256sum -c && \
    tar -C /tmp -xJf /tmp/zig.tar.xz && \
    mkdir -p /opt/zig && \
    mv /tmp/zig-linux-x86_64-* /opt/zig && \
    ln -s /opt/zig/bin/zig /usr/local/bin/zig && \
    rm /tmp/zig.tar.xz

# mkdocs etc.
RUN python3.10 -m pip install --no-cache-dir -U pip && \
    python3.10 -m pip install --no-cache-dir mkdocs mkdocs-material

# pwndbg source
WORKDIR /pwndbg
COPY . .

# CRITICAL FIX: Remove glibc 2.33 forcing from Makefile to use system glibc
RUN cd tests/binaries/host && \
    cp Makefile Makefile.backup && \
    sed -i '/GLIBC_2_33=/d' Makefile && \
    sed -i '/target native-native-gnu.2.33/d' Makefile && \
    sed -i '/rpath.*GLIBC_2_33/d' Makefile && \
    sed -i '/dynamic-linker.*GLIBC_2_33/d' Makefile && \
    sed -i '/#.*\\$/d' Makefile

# Install pwndbg with dev dependencies
RUN python3.10 -m venv /opt/pwndbg-venv && \
    /opt/pwndbg-venv/bin/pip install --no-cache-dir -U pip && \
    /opt/pwndbg-venv/bin/pip install --no-cache-dir ".[dev]"

# Set up environment
ENV PATH="/opt/pwndbg-venv/bin:${PATH}"
ENV ZIGPATH="/opt/zig"

# CRITICAL: Build test binaries with system glibc (not forced glibc 2.33)
RUN cd tests/binaries/host && \
    make clean && \
    /opt/zig/bin/zig cc \
        -Wall -DDEBUG=1 -ggdb -O0 -gdwarf-4 \
        -Wno-int-to-pointer-cast -Wno-int-conversion -Wno-unused-variable \
        -o heap_bugs.out heap_bugs.c && \
    /opt/zig/bin/zig cc \
        -Wall -DDEBUG=1 -ggdb -O0 -gdwarf-4 \
        -o heap_bins.out heap_bins.c && \
    gcc -g -O0 -Wno-nonnull -o heap_vis.out heap_vis.c -pthread -lpthread

# Create marker for testing capabilities
RUN echo "pwndbg-hybrid: 236/236 GDB tests + LLDB infrastructure ready" > /pwndbg/.container-info

ENTRYPOINT ["/bin/bash"]