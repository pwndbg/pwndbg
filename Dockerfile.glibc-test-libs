# This Dockerfile is used by ./.github/workflows/heap-libc-tests.yml and ./scripts/download-test-libs.sh
#
# Each /glibcs/<version>/ contains:
#   ld-X.XX.so              (dynamic linker)
#   ld-linux-x86-64.so.2 / ld-linux-aarch64.so.1 (per-arch symlink -> ld-X.XX.so)
#   libc-X.XX.so            (stripped libc)
#   libc.so.6               (symlink -> libc-X.XX.so)
#   .debug/libc-X.XX.so     (separate debug info)

FROM debian:12@sha256:ed4fcc40bb1162b6d2d32e7bec15044d13963779abbe63f67f1cd62b06220519 AS base-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    linux-libc-dev \
    wget \
    ca-certificates \
    bison \
    gawk \
    python3 \
    && rm -rf /var/lib/apt/lists/* \
    && MA="$(uname -m)-linux-gnu" \
    && ln -sf "/usr/include/${MA}/asm" /usr/include/asm \
    && ln -sf "/usr/include/${MA}/gnu" /usr/include/gnu \
    && ln -sf "/usr/include/${MA}/bits" /usr/include/bits \
    && ln -sf "/usr/include/${MA}/sys" /usr/include/sys

# Also create a no-debug variant of each libc into /glibcs-nodebug/<version>/
ENV GLIBC_BUILD_NODEBUG=1
COPY scripts/build-one-glibc.sh /build-one-glibc.sh
RUN chmod +x /build-one-glibc.sh

# Build each glibc version in a separate stage for caching. (stages don't invalidate each other like layers do)
# Add new versions here and in ./scripts/build-one-glibc.sh
FROM base-builder AS build-2.35
RUN /build-one-glibc.sh 2.35

FROM base-builder AS build-2.36
RUN /build-one-glibc.sh 2.36

FROM base-builder AS build-2.37
RUN /build-one-glibc.sh 2.37

FROM base-builder AS build-2.38
RUN /build-one-glibc.sh 2.38

FROM base-builder AS build-2.39
RUN /build-one-glibc.sh 2.39

FROM base-builder AS build-2.40
RUN /build-one-glibc.sh 2.40

FROM base-builder AS build-2.41
RUN /build-one-glibc.sh 2.41

FROM base-builder AS build-2.42
RUN /build-one-glibc.sh 2.42

FROM base-builder AS build-2.43
RUN /build-one-glibc.sh 2.43

FROM scratch
COPY --from=build-2.35 /glibcs/2.35 /glibcs/2.35
COPY --from=build-2.36 /glibcs/2.36 /glibcs/2.36
COPY --from=build-2.37 /glibcs/2.37 /glibcs/2.37
COPY --from=build-2.38 /glibcs/2.38 /glibcs/2.38
COPY --from=build-2.39 /glibcs/2.39 /glibcs/2.39
COPY --from=build-2.40 /glibcs/2.40 /glibcs/2.40
COPY --from=build-2.41 /glibcs/2.41 /glibcs/2.41
COPY --from=build-2.42 /glibcs/2.42 /glibcs/2.42
COPY --from=build-2.43 /glibcs/2.43 /glibcs/2.43
COPY --from=build-2.35 /glibcs-nodebug/2.35 /glibcs-nodebug/2.35
COPY --from=build-2.36 /glibcs-nodebug/2.36 /glibcs-nodebug/2.36
COPY --from=build-2.37 /glibcs-nodebug/2.37 /glibcs-nodebug/2.37
COPY --from=build-2.38 /glibcs-nodebug/2.38 /glibcs-nodebug/2.38
COPY --from=build-2.39 /glibcs-nodebug/2.39 /glibcs-nodebug/2.39
COPY --from=build-2.40 /glibcs-nodebug/2.40 /glibcs-nodebug/2.40
COPY --from=build-2.41 /glibcs-nodebug/2.41 /glibcs-nodebug/2.41
COPY --from=build-2.42 /glibcs-nodebug/2.42 /glibcs-nodebug/2.42
COPY --from=build-2.43 /glibcs-nodebug/2.43 /glibcs-nodebug/2.43
