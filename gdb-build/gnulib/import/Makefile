	$(AM_V_CC)$(CC) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(AM_CPPFLAGS) $(CPPFLAGS) $(libgnu_a_CFLAGS) $(CFLAGS) -MT libgnu_a-accept.o -MD -MP -MF $(DEPDIR)/libgnu_a-accept.Tpo -c -o libgnu_a-accept.o `test -f 'accept.c' || echo '$(srcdir)/'`accept.c
	$(AM_V_at)$(am__mv) $(DEPDIR)/libgnu_a-accept.Tpo $(DEPDIR)/libgnu_a-accept.Po
#	$(AM_V_CC)source='accept.c' object='libgnu_a-accept.o' libtool=no \
#	DEPDIR=$(DEPDIR) $(CCDEPMODE) $(depcomp) \
#	$(AM_V_CC_no)$(CC) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(AM_CPPFLAGS) $(CPPFLAGS) $(libgnu_a_CFLAGS) $(CFLAGS) -c -o libgnu_a-accept.o `test -f 'accept.c' || echo '$(srcdir)/'`accept.c

